# Local Claude Code settings (holds API keys — never commit)
.claude/settings.local.json

# Secrets / env — never commit. Use .env.example as the template.
.env
.env.local
.env*.local
.env.*
!.env.example
.dev.vars

# Caddy / Docker local state
caddy_data/
caddy_config/

# Server-side record of the last-deployed Caddyfile hash (deploy.yml) — used
# to decide whether the caddy container needs --force-recreate. Lives only
# on the deploy host, never belongs in git.
.caddyfile.sha256

# Pre-deploy DB dumps (deploy.yml's backup step, and manual pre-deploy backups)
# — full database contents, never belongs in git.
backups/

# OS / editor
.DS_Store
web/.pw-shot.mjs
web/.a11y-check.mjs
web/.console-check.mjs
web/.local-preview-webkit.mjs
web/.pw-shot-browser.mjs
web/.pw-shot-wait.mjs
