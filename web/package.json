{
  "name": "ahantime-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ahantime — smart steel marketplace (website). Layer 4 frontend.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "jobs:dev": "tsx scripts/jobs.ts",
    "price-sync": "tsx scripts/priceSync.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@tanstack/react-query": "^5.102.4",
    "@tiptap/core": "^3.30.3",
    "@tiptap/extension-image": "^3.30.3",
    "@tiptap/extension-table": "^3.30.3",
    "@tiptap/extensions": "^3.30.3",
    "@tiptap/pm": "^3.30.3",
    "@tiptap/react": "^3.30.3",
    "@tiptap/starter-kit": "^3.30.3",
    "date-fns-jalali": "3.6.0-1",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.10",
    "libphonenumber-js": "^1.13.11",
    "next": "^16.3.3",
    "next-intl": "^4.13.7",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "ulid": "^3.0.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.7",
    "@electric-sql/pglite-socket": "^0.2.10",
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^2.1.3",
    "autoprefixer": "^10.5.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.13.0",
    "eslint-config-next": "^16.3.3",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "stylelint": "^16",
    "stylelint-config-standard": "^36",
    "stylelint-declaration-strict-value": "^1.12",
    "stylelint-use-logical": "^2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^2.1.3",
    "wrangler": "^4.126.0"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "packageManager": "pnpm@9.12.0+sha512.4abf725084d7bcbafbd728bfc7bee61f2f791f977fd87542b3579dcb23504d170d46337945e4c66485cd12d588a0c0e570ed9c477e7ccdd8507cf05f3f92eaca",
  "pnpm": {
    "//": "Transitive-only pins. Each line is a package we do NOT depend on directly, so it can only be raised here. Re-check these against `pnpm audit --prod` when bumping deps — a stale floor here looks like a fix while pinning the project ON the vulnerable range, which is exactly what happened to postcss (was >=8.5.10, advisory had moved to <=8.5.22).",
    "overrides": {
      "postcss": ">=8.5.23",
      "brace-expansion": ">=5.0.9",
      "sharp": ">=0.35.0",
      "uuid": ">=11.1.1",
      "nanoid": ">=3.3.18",
      "minimatch@<9": ">=9.0.5"
    }
  }
}
