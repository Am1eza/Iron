# Copy to .env (cp .env.example .env) and fill in. Read by docker-compose.
# .env is gitignored — never commit real secrets.

# Public canonical URL (baked into the client bundle at build time).
NEXT_PUBLIC_SITE_URL=https://ahantime.com

# Data source: "live" (Postgres-backed backend) or "mock" (sample data, no DB).
NEXT_PUBLIC_API_MODE=live

# Free-form label surfaced on /api/health — no behavioral effect, just lets
# you confirm which deployment answered a request (see GEO-ROUTING.md).
NEXT_PUBLIC_DEPLOY_REGION=ir-docker

# Pre-built image tag to run (set automatically on the server by the GitHub
# Actions deploy workflow to ghcr.io/am1eza/iron-web:<git-sha> — see
# docker-compose.yml's comment on the web service and DEPLOY.md's
# "Automatic deploys" section). Leave unset for local
# `docker compose up -d --build`, which builds and tags
# `ghcr.io/am1eza/iron-web:local` from your working tree instead.
# WEB_IMAGE=

# REQUIRED in production. Generate one with:  openssl rand -hex 32
SESSION_SECRET=

# REQUIRED — Postgres password for the bundled db service.
# Generate one with:  openssl rand -hex 16
POSTGRES_PASSWORD=

# Gate /admin behind login. Defaults to ENFORCED when unset, and cannot be
# turned off at all under NODE_ENV=production — so leaving this out is safe.
# Set it to false ONLY for local dev, to reach /admin without the panel
# subdomain. Anything other than an explicit `false` means enforced.
AUTH_ENFORCED=true

# Seed the database with the benchmarked catalog on first boot (idempotent —
# only fills empty tables; set false once you manage the catalog from /admin).
SEED_ON_START=true

# Dev/staging convenience: this mobile becomes the seeded admin account.
# DEV_ADMIN_MOBILE=09120000000
# ADMIN_MOBILES=09xxxxxxxxx,09xxxxxxxxx   # admin allowlist bootstrap: only these mobiles may hold the admin role

# Refresh-token reuse detection (W29 · audit area 2). Rotation now keeps the
# spent token row and tags every token with a family id, so a stolen token that
# is replayed after the victim's own refresh is DETECTABLE — the old code could
# not tell it apart from a token that never existed.
#
#   detect  (default) report the reuse, revoke nothing. Externally identical to
#           the pre-W29 behaviour — the caller still just gets a 401 — so this
#           is safe to deploy with no risk of logging anyone out.
#   enforce additionally revoke the whole token family, so the victim's own
#           re-login actually evicts the thief. FLIP THIS ONLY after a week of
#           logs with zero `refresh_token_reuse` reports: a false positive logs
#           a real staff member out and costs an OTP SMS to recover.
#   off     no report either.
# REFRESH_REUSE_DETECTION=detect
#
# How long after a legitimate rotation a re-presentation of the same token is
# still treated as the silent-refresh timer racing itself (two tabs, a prefetch
# alongside a click) rather than as theft. Default 60. Do not set this to 0.
# REFRESH_REUSE_GRACE_SECONDS=60

# SMS.ir — REQUIRED with the defaults above (AUTH_ENFORCED=true): OTP login
# has no fallback in live mode, so the app refuses to boot without these.
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=          # OTP verify template ID from the SMS.ir panel (placeholder #OTP#)
SMSIR_TEMPLATE_PARAM=OTP         # placeholder name inside the verify template (the text between # signs)
SMSIR_LINE_NUMBER=          # optional — پیش‌فاکتور/alert texts dev-log (not sent) if unset

# ---------------------------------------------------------------------------
# Fully optional integrations. Leave blank to use dev fallbacks:
#   no BRSAPI_KEY      → usd/eur/gold18 skip the poll, ticker serves
#                        seeded/last-known values for those three only
#                        (global ounce is unaffected — separate source)
#   AI_ENABLED=false   → /api/ai/chat returns a polite "unavailable" message
# BRSAPI_KEY: free key from api.brsapi.ir/Panel/register.html (1500 req/day
# free tier — this feed uses one request per 60s poll tick, comfortably
# under it). BRSAPI_URL overrides the endpoint only if that ever changes.
# OUNCE_API_URL has its own free/keyless default baked into marketRates.ts;
# only set it to switch providers.
# ---------------------------------------------------------------------------
# BRSAPI_KEY=
# BRSAPI_URL=
# OUNCE_API_URL=
AI_ENABLED=false
# AI relay. Provider-NEUTRAL names since the owner moved the site off DeepSeek
# (its relay was permanently at HTTP 402, credit exhausted) to Parspack AI
# Studio. The legacy DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL / DEEPSEEK_MODEL
# names are STILL ACCEPTED — a running deployment keeps working until you
# rename them — but new deployments should use these.
# AI_API_KEY=
# AI_BASE_URL=https://ai.parspack.com/v1     # the out-of-Iran relay endpoint
# AI_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
#
# How much private "thinking" the model may spend before answering. The model
# above is a REASONING model and unconstrained it is unusable here: one short
# Persian greeting measured 1878 reasoning deltas against 88 content deltas —
# ~95% of the tokens and the latency spent on text the user never sees — which
# blew the AI_TIMEOUT_MS budget on any tool round trip and ended every answer
# in a 20s timeout. `low` (the default when unset) keeps tool calling working
# while cutting reasoning to a couple of hundred characters. `none` is
# cheapest but removes the margin multi-step tool selection relies on. `off`
# omits the parameter entirely, for a provider that rejects unknown fields.
# AI_REASONING_EFFORT=low
#
# Deadline for one advisor answer, in ms (default 45000). Was a hardcoded
# 20000, written for a non-reasoning model. A price question costs TWO relay
# round trips (model → tool → model) and this model's latency is wildly
# variable — three identical measured requests took 6.8s, 48.8s and 6.7s — so
# 20s did not protect anyone, it guaranteed an error on every tool-using
# question. A timeout now degrades to the same Persian "unavailable" message
# and the human path (never a raw error), and the user's Stop button still
# works, so this is a ceiling rather than a promise about how long anyone
# waits. Retune from your own numbers; do not set it to 0.
# AI_TIMEOUT_MS=45000
#
# Optional second relay, tried once when the primary fails. Legacy names
# FALLBACK_BASE_URL / FALLBACK_API_KEY / FALLBACK_MODEL still work. NOT tried
# for 402/401/403 — those are account-level refusals a second leg cannot fix.
# AI_FALLBACK_BASE_URL=
# AI_FALLBACK_API_KEY=
# AI_FALLBACK_MODEL=

# Daily TOKEN budget for the AI relay (W29 · audit area 29). Before this
# existed, the only guard was 10 requests / 5 min per IP — 2880 a day from a
# single address — and `ai_usage` recorded every token without anything ever
# reading it to enforce a limit. The relay hitting HTTP 402 (credit exhausted)
# is precisely what an absent cap produces.
#
# Counted as prompt + completion tokens since local midnight. When the cap is
# reached the advisor degrades gracefully — a clear Persian message and the
# human path (request a consultation / call), never a raw error, and never
# mid-answer. Tokens, not requests: one tool-heavy conversation costs more than
# a hundred greetings. `0` means "spend nothing"; leave unset for the default.
# AI_DAILY_TOKEN_BUDGET=400000

# Server-side error alerting (see web/src/lib/errors/sentry.ts) — a Sentry
# project's DSN, format https://<key>@<host>/<projectId>. Every
# reportError() call (unhandled API errors, job failures, integration
# failures) posts there once this is set; leave blank to keep console-only
# structured logging (the default today).
# SENTRY_DSN=

# ---------------------------------------------------------------------------
# GlitchTip → Telegram alert relay (W29 · audit area 16)
#
# GlitchTip has recorded 1939 issues and never told anyone: zero ProjectAlerts,
# zero recipients, zero notifications. Email cannot fix it — there is no SMTP
# on this host (docker-compose.yml says so explicitly). So a GlitchTip
# **Webhook** alert posts to /api/internal/alert-relay, which sends ONE
# Telegram message to the operator.
#
# NOT SMS. This relay shipped on SMS.ir and was moved off it by owner decision:
# error alerts must not draw down the SMS balance that OTP LOGIN depends on.
# SMS.ir is untouched and still owner-locked for OTP and پیش‌فاکتور.
#
# --- 1. The bot ------------------------------------------------------------
# Message @BotFather in Telegram → /newbot → pick a name and a @username.
# BotFather answers with the token below. Treat it as a password: anyone
# holding it can post as your bot. Leave unset and the relay answers
# `no_recipient` — it never pretends to have delivered.
# TELEGRAM_BOT_TOKEN=
#
# --- 2. Where alerts land --------------------------------------------------
# Simplest: open a chat with your new bot and press Start (a bot cannot message
# you until you do). For a team, create a group or channel and add the bot as
# an admin instead. Then send any message there and open
#   https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/getUpdates
# and read result[0].message.chat.id — positive for a private chat
# (123456789), negative for a group/channel (-1001234567890).
# TELEGRAM_ALERT_CHAT_ID=
#
# --- 2b. THE OUT-OF-IRAN HOP (required from this server) --------------------
# api.telegram.org is BLOCKED AT THE IRANIAN NATIONAL LEVEL. Measured from this
# host, not assumed:
#   getent hosts api.telegram.org  -> 10.10.34.36  (the filtering address)
#                                     2001:4188:2:600:10:10:34:36
#   TCP 443 to it                  -> "Connection refused" (v4), timeout (v6)
#   curl .../getMe                 -> HTTP 000 after 10s
#   control: api.github.com -> 200, registry.npmjs.org -> 200
# So a direct call can never succeed here. TELEGRAM_API_BASE points the relay
# at an out-of-Iran forwarder (the owner's Cloudflare Worker) that re-issues
# the request to Telegram. The relay builds ${TELEGRAM_API_BASE}/bot<token>/…
# and a trailing slash is trimmed for you.
#
# DO NOT "SIMPLIFY" THIS BACK TO A HARDCODED HOST. Doing so breaks the entire
# alert chain, and the breakage is invisible — a broken alerter cannot alert
# about itself. Unset, it defaults to https://api.telegram.org, which is
# correct for any deployment that is not behind the filter. Set to something
# that is not an http(s) URL, the relay refuses to send (`bad_api_base`)
# rather than silently falling back to the address that cannot work.
#
# NOTE: the bot token travels in the URL PATH — Telegram's API accepts it
# nowhere else — so whatever host is configured here is handed the credential.
# Point it only at a hop the owner controls. The token is redacted out of every
# log line and GlitchTip event by lib/errors/scrub.ts.
# TELEGRAM_API_BASE=https://api.telegram.org
#
# --- 2b. TELEGRAM_FORWARD_SECRET -------------------------------------------
# ONLY when TELEGRAM_API_BASE points at the forwarder (ops/telegram-forwarder.
# worker.js). A forwarder that accepts anyone's request is an open proxy in
# front of a bot token, so ours requires a shared secret and answers 403
# without it — set this to the same value as the Worker's FORWARD_SECRET.
#
# Sent as the `x-forward-secret` HEADER, never as a query parameter: the query
# string is the part of a URL that lands in access logs and Referer headers.
#
# Get this wrong and the failure is silent from the outside: every alert 403s
# at the hop, nothing is ever delivered, and the app reports only a generic
# http_error. If alerts stop arriving, check this first. To test the hop by
# hand (this is exactly what the app sends):
#   curl -X POST "$TELEGRAM_API_BASE/bot$TELEGRAM_BOT_TOKEN/sendMessage" \
#     -H "x-forward-secret: $TELEGRAM_FORWARD_SECRET" \
#     -H 'content-type: application/json' \
#     -d '{"chat_id":"'"$TELEGRAM_ALERT_CHAT_ID"'","text":"hop check"}'
# Expect {"ok":true,...}. A 403 means this value and the Worker's disagree.
# Leave unset when talking to api.telegram.org directly — Telegram neither
# wants nor understands the header.
# TELEGRAM_FORWARD_SECRET=
#
# --- 3. The webhook secret -------------------------------------------------
# The secret rides in the query string because GlitchTip's webhook alert lets
# you configure a URL and nothing else — there is no custom-header field. The
# route refuses to run at all while it is unset (fail closed).
#   Generate one with:  openssl rand -hex 32
# ALERT_RELAY_SECRET=
#
# --- 4. Throttling ---------------------------------------------------------
# An error storm is the NORMAL case here. Telegram is free, so the limits are
# looser than the old SMS ones (1/5min, 4/hour) — but there is still a hard
# ceiling, because Telegram's own per-chat limit is ~20 messages/minute, a
# channel that pings 300 times per deploy gets muted, and a delivery failure is
# itself an error that webhooks back into this route. At most one message per
# coalesce window and a hard ceiling per rolling hour; suppressed alerts are
# counted and reported in the next message, never silently dropped.
# ALERT_RELAY_COALESCE_SECONDS=60
# ALERT_RELAY_MAX_PER_HOUR=20
#
# --- 5. OWNER SETUP, once, in the GlitchTip UI (the code cannot do this) ----
#   GlitchTip → organization → project → Alerts → "Create New Alert"
#   → timespan 1 minute, notify when 1 event occurs
#   → Alert Recipients: **Webhook** (NOT Email)
#   → URL: https://ahantime.com/api/internal/alert-relay?key=<ALERT_RELAY_SECRET>
#   → Save, then "Send Test Notification" and confirm one Telegram message
#     arrives. A second test inside the coalesce window is EXPECTED not to
#     arrive — that is the coalescing working, not a failure.
# ---------------------------------------------------------------------------

# Redis (Docker deploy) — distributed rate limiting + read-through cache.
# Generate: openssl rand -hex 24. Unset → app uses in-process fallback.
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Added 2026-08-03 (audit, area 19): these are read by the code but were in
# neither .env.example. REDIS_URL in particular is load-bearing — without it
# rate limiting silently degrades from Redis-authoritative to a per-process
# in-memory window, so an attacker gets N x replicas attempts and nothing logs
# it. Its exact shape was only discoverable from docker-compose.yml.
# ---------------------------------------------------------------------------

# Redis connection string. Built from REDIS_PASSWORD above in docker-compose.
# Unset → per-process in-memory rate limiting only (weaker; see rateLimit.ts).
# REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379

# Cluster worker count for web/cluster.mjs. Default (unset) is
# min(cores-1, 3), sized for the original 4-vCPU host. On bigger boxes, raise
# this explicitly rather than changing the code default (which other/future
# hosts also rely on) — but check both budgets first:
#   - CPU: this host also runs db, redis, glitchtip (web+worker+db+redis),
#     matomo (+mariadb), caddy and the app's own jobs process. Leave at
#     least 2-3 cores of headroom, not just 1.
#   - Connections: total = WEB_CONCURRENCY x PG_POOL_MAX, plus one more
#     PG_POOL_MAX for the jobs process (scripts/jobs.mjs inherits the same
#     container env, see docker-entrypoint.sh) — must stay comfortably under
#     Postgres max_connections=100 to leave room for psql/pg_dump/backup
#     sessions during a deploy.
# On the current 8-core/15GB host: WEB_CONCURRENCY=5 with PG_POOL_MAX=10
# (this file's default below) -> 5x10+10=60 connections (well under 100)
# and leaves 3 cores for the services above.
# WEB_CONCURRENCY=3

# Postgres pool size PER worker process (and for the separate jobs process,
# which shares this var). Total = WEB_CONCURRENCY x this + this (jobs);
# keep that under the server's max_connections (100).
# NOTE: two different defaults exist depending on context. docker-compose.yml
# sets this explicitly (`PG_POOL_MAX: ${PG_POOL_MAX:-10}`), so every
# Docker-Compose deploy gets 10 even with no .env entry — verify with
# `docker compose config | grep PG_POOL_MAX` if in doubt. The `|| 15` fallback
# baked into web/src/lib/server/db/client.ts only applies when the app runs
# OUTSIDE docker-compose (bare `node`, tests, etc.) with the var truly unset.
# PG_POOL_MAX=10

# Set to "false" when the app is NOT behind exactly one trusted proxy — it
# disables per-IP rate-limit granularity instead of trusting spoofable headers.
# TRUST_PROXY=

# How long to wait for the primary OTP send before the delivery watchdog fires
# its second-stage attempt (see lib/auth/sms.ts).
# OTP_FALLBACK_AFTER_MS=

# Self-hosted Matomo. Without MATOMO_SITE_ID the analytics route serves an
# empty script and tracking is silently OFF.
# MATOMO_SITE_ID=
# MATOMO_INTERNAL_URL=http://matomo:80
# MATOMO_API_TOKEN=

# Optional third-party analytics / verification.
#
# GA4/GTM were deliberately left unset for a while: Google suspended Iranian
# users' Analytics accounts wholesale in 1403/10 (Jan 2025, no data recovery),
# and googletagmanager.com is unreachable for some fraction of Iranian
# visitors. The owner reviewed this explicitly (2026-08-26) and chose to
# proceed anyway, accessing the Google account through a fixed-IP VPN as
# mitigation for the account-suspension risk — the visitor-reachability risk
# for some fraction of Iranian traffic remains and is accepted. Set GTM_ID
# (not GA4_ID) — Analytics.tsx skips standalone gtag.js when GTM_ID is set,
# since the GA4 Configuration tag lives inside the GTM container instead; see
# docs/ANALYTICS.md §3 for the full history and web/src/lib/analytics/track.ts
# for how conversion events reach GA4 through GTM's dataLayer.
# GA4_ID=
# GTM_ID=
# GSC_VERIFICATION=

# Google Search Console API (US-14.4) — the per-article search-performance
# panel in the content editor. NOT the same thing as GSC_VERIFICATION above
# (that is just the ownership meta tag).
#
# Only the site owner can produce these: create an OAuth 2.0 Client ID of type
# "Web application" in a Google Cloud project that has the Search Console API
# enabled, and add EXACTLY this authorised redirect URI —
#   https://panel.ahantime.com/api/admin/seo/search-console/callback
# Then set the three values below, restart `web`, and connect once from
# /admin/seo. Leave them unset and the whole feature stays invisible: no panel
# in the editor, no background job, no requests to Google.
# GSC_CLIENT_ID=
# GSC_CLIENT_SECRET=
# The property exactly as Search Console spells it — `sc-domain:ahantime.com`
# (Domain property) or `https://ahantime.com/` WITH the trailing slash
# (URL-prefix property). Google matches this string literally; a mismatch
# returns rows for nothing and looks like a permissions error.
# GSC_SITE_URL=
# GSC_REDIRECT_URI=
#
# Relay overrides, same pattern as AI_BASE_URL. Google's endpoints are
# directly reachable from the production host today (measured), so these stay
# unset; they exist so a future block is an .env edit, not a code change.
# GSC_AUTH_BASE_URL=
# GSC_TOKEN_BASE_URL=
# GSC_API_BASE_URL=

# Google PageSpeed Insights API (2026-08-26) — real Core Web Vitals +
# Lighthouse SEO/performance scores for the homepage and /prices, shown in
# the SEO panel. Free, no billing required. Get a key from a Google Cloud
# project with the PageSpeed Insights API enabled (Credentials → Create
# credentials → API key); restrict it to that one API and, since this is
# called server-side only, to the production server's IP. Leave unset and
# the panel section stays invisible — same contract as the GSC block above.
# PAGESPEED_API_KEY=

# Build-target switches, set by the Dockerfile / pages workflow. Do not set by hand.
# BUILD_STANDALONE=1
# PAGES_BASE_PATH=

# e2e ONLY — set exclusively by playwright.config.ts's webServer. It
# short-circuits EVERY rate-limit scope, including otp-request, so leaking it
# into a production env would uncap SMS.ir sends billed to the owner. Ignored
# when NODE_ENV=production (enforced in lib/server/utils/rateLimit.ts).
# DISABLE_RATE_LIMIT_FOR_TESTS=true
